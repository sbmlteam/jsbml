<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" xmlns:distrib="http://www.sbml.org/sbml/level3/version1/distrib/version1" level="3" version="2" distrib:required="true">
  <model id="distrib_uncertainties" name="distrib uncertainties">
    <listOfCompartments>
      <compartment id="C" size="1" units="litre" constant="true">
        <distrib:listOfUncertainties>
          <distrib:uncertainty>
            <distrib:uncertParameter distrib:value="0.1" distrib:units="litre" distrib:type="standardDeviation"/>
          </distrib:uncertainty>
        </distrib:listOfUncertainties>
      </compartment>
    </listOfCompartments>
    <listOfSpecies>
      <species id="S1" compartment="C" initialConcentration="4.2" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false">
        <distrib:listOfUncertainties>
          <distrib:uncertainty distrib:id="u_S1_a" distrib:name="measured">
            <distrib:uncertParameter distrib:value="4.2" distrib:type="mean"/>
            <distrib:uncertParameter distrib:value="0.3" distrib:type="variance"/>
          </distrib:uncertainty>
          <distrib:uncertainty distrib:id="u_S1_b">
            <distrib:uncertSpan distrib:type="confidenceInterval" distrib:valueLower="3.5" distrib:valueUpper="4.9"/>
          </distrib:uncertainty>
        </distrib:listOfUncertainties>
      </species>
      <species id="S2" compartment="C" initialConcentration="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k1" value="1" units="dimensionless" constant="true">
        <distrib:listOfUncertainties>
          <distrib:uncertainty>
            <distrib:uncertParameter distrib:var="sd_k1" distrib:type="standardDeviation"/>
            <distrib:uncertSpan distrib:type="range" distrib:varLower="sd_k1" distrib:valueUpper="10"/>
            <distrib:uncertParameter distrib:type="distribution" distrib:definitionURL="http://www.sbml.org/sbml/symbols/distrib/normal">
              <math xmlns="http://www.w3.org/1998/Math/MathML">
                <apply>
                  <csymbol encoding="text" definitionURL="http://www.sbml.org/sbml/symbols/distrib/normal"> normal </csymbol>
                  <cn type="integer"> 1 </cn>
                  <ci> sd_k1 </ci>
                </apply>
              </math>
              <distrib:listOfUncertParameters>
                <distrib:uncertParameter distrib:name="skew" distrib:value="0.1" distrib:type="externalParameter" distrib:definitionURL="http://www.probonto.org/ontology#PROB_k0000225"/>
              </distrib:listOfUncertParameters>
            </distrib:uncertParameter>
          </distrib:uncertainty>
        </distrib:listOfUncertainties>
      </parameter>
      <parameter id="sd_k1" value="0.2" units="dimensionless" constant="true"/>
      <parameter id="p_ia" value="0" units="dimensionless" constant="true"/>
      <parameter id="p_rule" value="0" units="dimensionless" constant="false"/>
    </listOfParameters>
    <listOfInitialAssignments>
      <initialAssignment symbol="p_ia">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <cn type="integer"> 2 </cn>
            <ci> k1 </ci>
          </apply>
        </math>
        <distrib:listOfUncertainties>
          <distrib:uncertainty>
            <distrib:uncertParameter distrib:value="0.05" distrib:type="coeffientOfVariation"/>
          </distrib:uncertainty>
        </distrib:listOfUncertainties>
      </initialAssignment>
    </listOfInitialAssignments>
    <listOfRules>
      <assignmentRule variable="p_rule">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> k1 </ci>
            <ci> S1 </ci>
          </apply>
        </math>
        <distrib:listOfUncertainties>
          <distrib:uncertainty>
            <distrib:uncertParameter distrib:value="0.05" distrib:type="coeffientOfVariation"/>
          </distrib:uncertainty>
        </distrib:listOfUncertainties>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction id="J0" reversible="false">
        <listOfReactants>
          <speciesReference id="sr1" species="S1" stoichiometry="1" constant="true">
            <distrib:listOfUncertainties>
              <distrib:uncertainty>
                <distrib:uncertParameter distrib:value="0.5" distrib:type="standardDeviation"/>
              </distrib:uncertainty>
            </distrib:listOfUncertainties>
          </speciesReference>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="S2" stoichiometry="1" constant="true">
            <distrib:listOfUncertainties>
              <distrib:uncertainty>
                <distrib:uncertParameter distrib:value="1" distrib:type="mean"/>
              </distrib:uncertainty>
            </distrib:listOfUncertainties>
          </speciesReference>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> k1 </ci>
              <ci> kl </ci>
              <ci> S1 </ci>
            </apply>
          </math>
          <listOfLocalParameters>
            <localParameter id="kl" value="1" units="dimensionless">
              <distrib:listOfUncertainties>
                <distrib:uncertainty>
                  <distrib:uncertSpan distrib:type="interquartileRange" distrib:valueLower="0.1"/>
                </distrib:uncertainty>
              </distrib:listOfUncertainties>
            </localParameter>
          </listOfLocalParameters>
          <distrib:listOfUncertainties>
            <distrib:uncertainty>
              <distrib:uncertParameter distrib:type="externalParameter" distrib:definitionURL="http://www.uncertml.org/distributions/normal"/>
            </distrib:uncertainty>
          </distrib:listOfUncertainties>
        </kineticLaw>
        <distrib:listOfUncertainties>
          <distrib:uncertainty>
            <distrib:uncertParameter distrib:value="1.5" distrib:type="median"/>
          </distrib:uncertainty>
        </distrib:listOfUncertainties>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
